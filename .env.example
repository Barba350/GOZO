# Referencia únicamente. No escribas secretos reales en este archivo.
# Configuración de producción pendiente de definir base externa gratuita.
# La versión local se inicia con dotnet run -- --crear-dueno.
ASPNETCORE_ENVIRONMENT=Production
GOZO_DATA_DIR=/data
# GOZO_PERSISTENT_SQLITE=true SOLO si existe un disco persistente real.
# No activarlo en Render Free.
GOZO_PUBLIC_ORIGIN=https://TU-SERVICIO.onrender.com
GOZO_TLS_TERMINATION=Edge
GOZO_ADMIN_USERNAME=
GOZO_ADMIN_PASSWORD=
