# Plantilla SIN secretos. Configurar los valores reales en Render.
ASPNETCORE_ENVIRONMENT=Production
GOZO_DB_PROVIDER=PostgreSQL
GOZO_POSTGRES_CONNECTION=Host=HOST_NEON;Database=neondb;Username=USUARIO;Password=CAMBIAR;SSL Mode=VerifyFull
GOZO_DATA_DIR=/data
GOZO_PUBLIC_ORIGIN=https://TU-SERVICIO.onrender.com
GOZO_TLS_TERMINATION=Edge
GOZO_ADMIN_USERNAME=
GOZO_ADMIN_PASSWORD=
# Local: omitir GOZO_DB_PROVIDER y GOZO_POSTGRES_CONNECTION para usar SQLite.
